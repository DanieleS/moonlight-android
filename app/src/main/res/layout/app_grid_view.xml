<?xml version="1.0" encoding="utf-8"?>
<!--
    The library grid. Span count and tile spacing are set in code, in AppView, since the
    column count auto-fits the panel width and the spacing depends on the icon-size
    preference. The focus ring is each tile's own foreground now, so there is no
    listSelector.
-->
<com.limelight.ui.ContextMenuRecyclerView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragmentView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:focusable="true"
    android:descendantFocusability="afterDescendants" />
