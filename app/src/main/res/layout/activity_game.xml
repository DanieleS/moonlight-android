<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Game" >

    <View
        android:id="@+id/backgroundTouchView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />
    
    <com.limelight.ui.StreamContainer
        android:id="@+id/streamContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:defaultFocusHighlightEnabled="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:focusedByDefault="true">
    <requestFocus />
    </com.limelight.ui.StreamContainer>

<!--    <com.limelight.ui.ApertureViewGroup-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="match_parent"-->
<!--        app:aperture_color1="#5CF950"-->
<!--        android:layout_gravity="center"-->
<!--        android:padding="5dp"-->
<!--        app:aperture_color2="#FC9595"-->
<!--        app:aperture_border_width="10dp"-->
<!--        app:aperture_border_angle="24dp"-->
<!--        app:aperture_duration="6000"-->
<!--        app:aperture_middle_color="#6CD2F8">-->
<!--    </com.limelight.ui.ApertureViewGroup>-->

    <TextView
        android:id="@+id/notificationOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="10dp"
        android:layout_gravity="right"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:gravity="right"
        android:background="@color/scrim"
        android:preferKeepClear="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/performanceOverlay"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/performanceOverlayBig"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_gravity="left"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:gravity="left"
            android:background="@color/scrim"
            android:preferKeepClear="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/performanceOverlayLite"
            tools:text="延迟/解码：109ms/7ms 丢包率：69% FPS：60"
            android:textSize="10sp"
            android:layout_marginTop="4dp"
            android:background="@drawable/ic_hud_bg"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <!-- Floating Menu Button -->
    <ImageButton
        android:id="@+id/floatingMenuButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="24dp"
        android:background="@drawable/floating_menu_button"
        android:contentDescription="@string/menu_button"
        android:src="@drawable/ic_menu"
        android:padding="6dp"
        android:visibility="gone"
        android:elevation="9999dp" />

    <ImageButton
        android:id="@+id/overlayToggleZoomButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="24dp"
        android:background="@drawable/floating_menu_button"
        android:src="@drawable/ic_zoom_toggle"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/toggle_pan_zoom_mode"
        android:visibility="gone"
        android:elevation="9999dp" />

    <!--
        The connection scene. Shown from the moment the activity is created until the
        stream is live, then faded away. It is the game's own cover on the true-black
        ground, a living signal halo around it while the host works, and the wait broken
        into a handful of phases a player can actually follow — not the system spinner it
        replaces. Opaque, so the black surface below it never shows through.
    -->
    <FrameLayout
        android:id="@+id/connectionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_deep"
        android:clickable="true"
        android:focusable="false"
        android:elevation="200dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingBottom="8dp">

            <!-- The cover, wrapped in a soft signal halo. The wrapper is INSET_DP larger
                 than the cover on every side so the glow has room to bleed past the art
                 (keep CoverGlowView.INSET_DP in step with that margin). Sized to leave the
                 title, progress and phase comfortable room on a landscape screen. -->
            <FrameLayout
                android:layout_width="206dp"
                android:layout_height="256dp">

                <com.limelight.ui.CoverGlowView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <FrameLayout
                    android:layout_width="150dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/connectionCover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/connection_cover_placeholder"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/TileShape" />

                    <!-- Stands in for the cover when the host has no art for this game. -->
                    <TextView
                        android:id="@+id/connectionCoverTitle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:padding="12dp"
                        android:textColor="@color/content_primary"
                        android:textSize="20sp"
                        android:visibility="gone" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/connectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="sans-serif-light"
                android:maxWidth="320dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:gravity="center"
                android:textColor="@color/content_primary"
                android:textSize="23sp" />

            <TextView
                android:id="@+id/connectionPcName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.14"
                android:singleLine="true"
                android:textAllCaps="true"
                android:textColor="@color/content_muted"
                android:textSize="11sp" />

            <ProgressBar
                android:id="@+id/connectionProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="216dp"
                android:layout_height="3dp"
                android:layout_marginTop="22dp"
                android:max="1000"
                android:progress="0"
                android:progressBackgroundTint="@color/divider"
                android:progressTint="@color/signal" />

            <TextView
                android:id="@+id/connectionPhase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/content_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/connectionHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/conn_scene_cancel_hint"
                android:textColor="@color/content_faint"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

</merge>