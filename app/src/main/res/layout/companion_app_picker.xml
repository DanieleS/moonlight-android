<?xml version="1.0" encoding="utf-8"?>
<!--
    The companion picker's panel: the same raised surface and quiet header a menu sheet wears,
    but holding a grid of app icons rather than a column of actions — choosing an app is
    recognising it, not reading it. The "None" row above the grid is added in code, and only
    when there is a choice to clear.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/menu_sheet_bg"
    android:orientation="vertical"
    android:paddingStart="@dimen/menu_sheet_padding"
    android:paddingEnd="@dimen/menu_sheet_padding"
    android:paddingTop="14dp"
    android:paddingBottom="@dimen/menu_sheet_padding">

    <TextView
        android:id="@+id/companionPickerTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:ellipsize="end"
        android:letterSpacing="0.16"
        android:singleLine="true"
        android:textAllCaps="true"
        android:textColor="@color/content_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/companionPickerNone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <com.limelight.ui.MaxHeightRecyclerView
        android:id="@+id/companionPickerGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:scrollbars="none" />

</LinearLayout>
