<?xml version="1.0" encoding="utf-8"?>
<!--
    The companion surface. Exactly one of the two children is visible: the app name while idle,
    the stats dashboard while streaming.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_deep">

    <!-- The spotlighted game's background/hero art, when the host has one. Behind everything;
         a scrim keeps the text on top of it legible. Both are toggled from code. -->
    <ImageView
        android:id="@+id/companionBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/companionBackdropScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/coverflow_scrim"
        android:visibility="gone" />

    <!--
        Idle surface. Shows the game currently spotlighted in the library: its name, a meta line
        (year · genres · score) and a description. With no game selected it falls back to the app
        name, so it is never empty.
    -->
    <LinearLayout
        android:id="@+id/companionIdle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <TextView
            android:id="@+id/companionIdleTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxWidth="720dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="@string/app_label"
            android:textColor="@color/content_primary"
            android:textSize="30sp"
            android:letterSpacing="0.04"
            android:fontFamily="sans-serif-light" />

        <TextView
            android:id="@+id/companionIdleMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:maxWidth="720dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/content_muted"
            android:textSize="13sp"
            android:letterSpacing="0.12"
            android:textAllCaps="true"
            android:visibility="gone" />

        <!--
            The description is as long as the host makes it, so it scrolls rather than truncating.
            Sized wrap_content inside a match_parent column, it grows only as far as the space the
            title and meta line leave it, and scrolls beyond that. The fading edge is what tells
            the reader there is more below.
        -->
        <ScrollView
            android:id="@+id/companionIdleDescriptionScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fillViewport="true"
            android:scrollbars="vertical"
            android:scrollbarThumbVertical="@color/divider"
            android:requiresFadingEdge="vertical"
            android:fadingEdgeLength="28dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/companionIdleDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxWidth="720dp"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/content_secondary"
                android:textSize="14sp" />

        </ScrollView>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/companionStats"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="20dp">

        <!-- Hero: what is being streamed, and how fast. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/companion_label_stream"
                    android:textColor="@color/content_muted"
                    android:textSize="10sp"
                    android:letterSpacing="0.16"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/companionResolution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/content_primary"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/companionFps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/signal"
                    android:textSize="44sp"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/companion_label_fps"
                    android:textColor="@color/content_muted"
                    android:textSize="11sp"
                    android:letterSpacing="0.16"
                    android:textAllCaps="true"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@color/divider" />

        <!-- The four numbers worth watching mid-game. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/CompanionTileLabel"
                    android:text="@string/companion_label_latency" />

                <TextView
                    android:id="@+id/companionLatency"
                    style="@style/CompanionTileValue" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/CompanionTileLabel"
                    android:text="@string/companion_label_decode" />

                <TextView
                    android:id="@+id/companionDecodeTime"
                    style="@style/CompanionTileValue" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/CompanionTileLabel"
                    android:text="@string/companion_label_loss" />

                <TextView
                    android:id="@+id/companionLoss"
                    style="@style/CompanionTileValue" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/CompanionTileLabel"
                    android:text="@string/companion_label_bandwidth" />

                <TextView
                    android:id="@+id/companionBandwidth"
                    style="@style/CompanionTileValue" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="14dp"
            android:background="@color/divider" />

        <!-- Detail, for when something above looks wrong. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/CompanionDetailLabel"
                android:text="@string/companion_label_frames" />

            <TextView
                android:id="@+id/companionFrames"
                style="@style/CompanionDetailValue" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/companionHostRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                style="@style/CompanionDetailLabel"
                android:text="@string/companion_label_host" />

            <TextView
                android:id="@+id/companionHostLatency"
                style="@style/CompanionDetailValue" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                style="@style/CompanionDetailLabel"
                android:text="@string/companion_label_decoder" />

            <TextView
                android:id="@+id/companionDecoder"
                style="@style/CompanionDetailValue"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

    </LinearLayout>

    <!--
        A game's telemetry view. Sits above the stats because when a game has a view, that view is
        what the panel is for; the stats are what it falls back to. Its content comes from the host
        and is rendered with no origin and no file access - see CompanionPresentation.
    -->
    <WebView
        android:id="@+id/companionTelemetryView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Opens the in-game menu here on the panel. Only out while a game is streaming; the
         idle library surface has no menu to raise. Kept at the bottom so it clears the stats
         header, whose FPS readout owns the top-right corner. -->
    <ImageButton
        android:id="@+id/companionMenuButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:background="@drawable/floating_menu_button"
        android:contentDescription="@string/menu_button"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_menu"
        android:visibility="gone" />

    <!--
        The in-game menu, drawn here so the game on the main screen stays whole while it is
        open. The rows are navigated by the gamepad, routed over from the Game activity, and
        the selected one is marked activated since this window holds no input focus of its own.
    -->
    <FrameLayout
        android:id="@+id/companionMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:clickable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:background="@drawable/menu_sheet_bg"
            android:orientation="vertical"
            android:paddingStart="@dimen/menu_sheet_padding"
            android:paddingEnd="@dimen/menu_sheet_padding"
            android:paddingTop="16dp"
            android:paddingBottom="@dimen/menu_sheet_padding">

            <TextView
                android:id="@+id/companionMenuTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                android:ellipsize="end"
                android:letterSpacing="0.16"
                android:singleLine="true"
                android:textAllCaps="true"
                android:textColor="@color/content_muted"
                android:textSize="13sp" />

            <com.limelight.ui.MaxHeightScrollView
                android:id="@+id/companionMenuScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/companionMenuItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </com.limelight.ui.MaxHeightScrollView>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
