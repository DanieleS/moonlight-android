<?xml version="1.0" encoding="utf-8"?>
<!--
    A menu's panel: a raised, hairlined surface with a quiet header and a scrolling column
    of actions. The same panel whether it rises as a sheet in the library or sits centred
    over a game. Rows are added to @id/menuSheetItems in code.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/menu_sheet_bg"
    android:orientation="vertical"
    android:paddingStart="@dimen/menu_sheet_padding"
    android:paddingEnd="@dimen/menu_sheet_padding"
    android:paddingTop="14dp"
    android:paddingBottom="@dimen/menu_sheet_padding">

    <TextView
        android:id="@+id/menuSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:ellipsize="end"
        android:letterSpacing="0.16"
        android:singleLine="true"
        android:textAllCaps="true"
        android:textColor="@color/content_muted"
        android:textSize="12sp" />

    <com.limelight.ui.MaxHeightScrollView
        android:id="@+id/menuSheetScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/menuSheetItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </com.limelight.ui.MaxHeightScrollView>

</LinearLayout>
