<?xml version="1.0" encoding="utf-8"?>
<!--
    The settings screen. A Material 3 top app bar over a scrolling column of preferences.
    The bar carries the title and a back arrow; a hairline holds its edge against the list
    below, in the same grammar the library's top bar and menu sheets already speak. The
    preference fragment is committed into @id/stream_settings in code.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_deep"
    android:orientation="vertical"
    tools:context=".preferences.StreamSettings">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/settings_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_deep"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/settings_toolbar"
            style="@style/Widget.Ratatoskr.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_bar_height"
            app:navigationContentDescription="@string/settings_back"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/title_stream_settings" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- A hairline, not a shadow: the app holds edges with a rule against true black. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <FrameLayout
        android:id="@+id/stream_settings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
