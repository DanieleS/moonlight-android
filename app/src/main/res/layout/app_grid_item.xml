<?xml version="1.0" encoding="utf-8"?>
<!--
    One app in the library. The cell is the art and nothing else; the space between tiles
    belongs to the grid. That is what lets @drawable/tile_focus_ring, which AbsListView
    positions on the cell bounds, ring the art exactly.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="150dp"
    android:layout_height="200dp"
    android:foreground="@drawable/tile_focus_ring"
    android:focusable="true"
    android:clickable="true">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/grid_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:cropToPadding="false"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/TileShape" />

    <View
        android:id="@+id/grid_running_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/tile_running_scrim"
        android:visibility="gone" />

    <!-- The title only appears for an app with no box art of its own. -->
    <RelativeLayout
        android:id="@+id/grid_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/grid_overlay"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="50dp" />

        <TextView
            android:id="@+id/grid_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/grid_overlay"
            android:layout_margin="5dp"
            android:gravity="center|center_vertical"
            android:textAlignment="center"
            android:textColor="@color/content_primary"
            android:textSize="18sp" />
    </RelativeLayout>

</FrameLayout>
