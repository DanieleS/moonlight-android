<?xml version="1.0" encoding="utf-8"?>
<!-- The grid is declared before the bar it is drawn below; see @layout/activity_pc_view. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AppView">

    <FrameLayout
        android:id="@+id/appFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/topBar" />

    <LinearLayout
        android:id="@+id/topBar"
        style="@style/TopBar"
        android:layout_alignParentTop="true">

        <!-- The name of the PC these apps belong to. -->
        <TextView
            android:id="@+id/appListText"
            style="@style/TopBarTitle"
            android:preferKeepClear="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profilesButton"
            style="@style/TopBarProfile"
            android:contentDescription="@string/profile_manager_choose_profile"
            app:icon="@drawable/ic_profiles" />

    </LinearLayout>

</RelativeLayout>
