<?xml version="1.0" encoding="utf-8"?>
<!-- The grid is declared before the bar it is drawn below; see @layout/activity_pc_view. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AppView">

    <FrameLayout
        android:id="@+id/appFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/topBar" />

    <LinearLayout
        android:id="@+id/topBar"
        style="@style/TopBar"
        android:layout_alignParentTop="true">

        <!-- The name of the PC these apps belong to. -->
        <TextView
            android:id="@+id/appListText"
            style="@style/TopBarTitle"
            android:preferKeepClear="true" />

        <!-- The way back to the PCs. Back leaves the app from here, so this is the only one. -->
        <ImageButton
            android:id="@+id/pcsButton"
            style="@style/TopBarAction"
            android:contentDescription="@string/action_change_pc"
            android:src="@drawable/ic_computer" />

        <ImageButton
            android:id="@+id/companionButton"
            style="@style/TopBarAction"
            android:contentDescription="@string/action_companion_hide"
            android:src="@drawable/ic_companion_on" />

        <!-- Launches the host's Virtual Display shortcut, which is otherwise hidden from the
             library. Only shown when the host advertises that entry. -->
        <ImageButton
            android:id="@+id/virtualDisplayButton"
            style="@style/TopBarAction"
            android:contentDescription="@string/action_virtual_display"
            android:src="@drawable/ic_virtual_display"
            android:visibility="gone" />

        <!-- The order the games are listed in. Lives here rather than in a game's own menu,
             and so is reachable in the carousel too by revealing the bar. -->
        <ImageButton
            android:id="@+id/sortButton"
            style="@style/TopBarAction"
            android:contentDescription="@string/action_sort"
            android:src="@drawable/ic_sort" />

        <ImageButton
            android:id="@+id/viewModeButton"
            style="@style/TopBarAction"
            android:contentDescription="@string/action_all_games"
            android:src="@drawable/ic_view_grid" />

        <!-- The general actions, brought here from the PC-selection screen the library now
             tends to skip over. Adding a PC belongs to that screen and stays there. -->
        <ImageButton
            android:id="@+id/helpButton"
            style="@style/TopBarAction"
            android:contentDescription="@string/action_help"
            android:src="@drawable/ic_help" />

        <ImageButton
            android:id="@+id/settingsButton"
            style="@style/TopBarAction"
            android:contentDescription="@string/action_settings"
            android:src="@drawable/ic_settings" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profilesButton"
            style="@style/TopBarProfile"
            android:contentDescription="@string/profile_manager_choose_profile"
            app:icon="@drawable/ic_profiles" />

    </LinearLayout>

    <!--
        The view-mode shortcut, always on screen in both views: it names the gamepad button that
        switches between the carousel and the grid, and it is a touch target itself. Declared last
        so it floats over the library; not focusable, so it never intercepts the d-pad.
    -->
    <LinearLayout
        android:id="@+id/viewModeHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/hint_pill_bg"
        android:paddingStart="8dp"
        android:paddingEnd="14dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:clickable="true"
        android:focusable="false">

        <TextView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/hint_badge_bg"
            android:gravity="center"
            android:text="@string/hint_button_rb"
            android:textColor="@color/content_secondary"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/viewModeHintLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:text="@string/action_all_games"
            android:textColor="@color/content_secondary"
            android:textSize="11sp"
            android:letterSpacing="0.12"
            android:textAllCaps="true"
            android:includeFontPadding="false" />

    </LinearLayout>

</RelativeLayout>
