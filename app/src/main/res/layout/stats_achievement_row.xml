<?xml version="1.0" encoding="utf-8"?>
<!-- An achievement in a list across games: its icon, its name, and the game and when beneath.
     Opens that game's statistics and achievements. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="2dp"
    android:background="@drawable/menu_row_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <ImageView
        android:id="@+id/statsAchievementIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/stats_icon_bg"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/statsAchievementName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/content_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/statsAchievementDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/content_muted"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
