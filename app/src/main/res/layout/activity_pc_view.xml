<?xml version="1.0" encoding="utf-8"?>
<!--
    The actions sit in a bar along the top in both orientations, so this screen no longer
    has a layout-land variant: that one existed only to stack the same buttons down the
    left edge.

    The grid is declared before the bar, though it is drawn below it. Declaration order is
    focus order, and an AbsListView makes itself unfocusable while its adapter is empty, so
    a grid declared second would hand the first press of the d-pad to the bar while the PCs
    were still being discovered.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PcView">

    <RelativeLayout
        android:id="@+id/pcFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/topBar"
        android:gravity="center">

        <!-- No PC yet: the spinner over the explanation, centred, rather than the two of them
             side by side against the left of a screen that is otherwise empty. -->
        <LinearLayout
            android:id="@+id/no_pc_found_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:maxWidth="@dimen/pc_card_max_width"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingRight="@dimen/activity_horizontal_margin">

            <ProgressBar
                android:id="@+id/pcs_loading"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminate="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/searching_pc"
                android:textColor="@color/content_muted"
                android:textSize="16sp" />
        </LinearLayout>

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/topBar"
        style="@style/TopBar"
        android:layout_alignParentTop="true">

        <TextView
            style="@style/TopBarTitle"
            android:text="@string/app_label" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profilesButton"
            style="@style/TopBarProfile"
            android:contentDescription="@string/profile_manager_choose_profile"
            app:icon="@drawable/ic_profiles" />

        <ImageButton
            android:id="@+id/helpButton"
            style="@style/TopBarAction"
            android:contentDescription="@string/action_help"
            android:src="@drawable/ic_help" />

        <ImageButton
            android:id="@+id/manuallyAddPc"
            style="@style/TopBarAction"
            android:contentDescription="@string/action_add_pc"
            android:src="@drawable/ic_add" />

        <ImageButton
            android:id="@+id/settingsButton"
            style="@style/TopBarAction"
            android:contentDescription="@string/action_settings"
            android:src="@drawable/ic_settings" />

    </LinearLayout>

</RelativeLayout>
