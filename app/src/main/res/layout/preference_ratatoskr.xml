<?xml version="1.0" encoding="utf-8"?>
<!--
    A settings row in the app's own grammar rather than Material's. The stock row sets
    title and summary at nearly the same weight, so a screen of them reads as a wall of
    prose; here they sit two steps apart on the prominence ladder — the title in
    content_primary, the explanation muted and a size down — and the row keeps the same
    gutter as the category header above it so the column has one edge.

    The ids are the framework's (@android:id/title, summary, icon, widget_frame): androidx
    binds them by id, and the widget frame is where a switch or a seek bar is inflated.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:baselineAligned="false"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/settings_gutter"
    android:paddingEnd="@dimen/settings_gutter"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/icon_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:minWidth="40dp"
        android:orientation="horizontal"
        android:paddingEnd="12dp">

        <androidx.preference.internal.PreferenceImageView
            android:id="@android:id/icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="24dp"
            android:maxHeight="24dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Ratatoskr.PreferenceTitle" />

        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textAppearance="@style/TextAppearance.Ratatoskr.PreferenceSummary" />

    </LinearLayout>

    <!-- The switch, seek bar or other control. Nothing of ours goes here. -->
    <LinearLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="vertical"
        android:paddingStart="12dp" />

</LinearLayout>
