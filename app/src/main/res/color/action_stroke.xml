<?xml version="1.0" encoding="utf-8"?>
<!-- MaterialButton draws its own background, so its focus ring is a stroke rather than @drawable/action_button_bg. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:color="@color/signal" />
    <item android:state_focused="true" android:color="@color/signal" />
    <item android:color="@android:color/transparent" />
</selector>
