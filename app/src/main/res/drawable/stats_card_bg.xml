<?xml version="1.0" encoding="utf-8"?>
<!--
    A statistics card: the raised surface with a hairline that the menu sheet and the PC cards
    stand on, at the row's corner. Focus is never drawn here; the focusable rows inside a card
    carry their own ring.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/stats_card_corner" />
    <solid android:color="@color/surface_raised" />
    <stroke
        android:width="1dp"
        android:color="@color/divider" />
</shape>
