<?xml version="1.0" encoding="utf-8"?>
<!--
    @drawable/pc_focus_ring at the card's radius. The cards fill the width, so unlike the
    old icon cells they have no padding of their own to hold the ring off the content: the
    ring sits on the card's edge, exactly where its hairline is.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="120">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/pc_card_corner" />
            <solid android:color="@color/signal_wash" />
            <stroke
                android:width="@dimen/tile_focus_stroke"
                android:color="@color/signal" />
        </shape>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/pc_card_corner" />
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="@dimen/tile_focus_stroke"
                android:color="@color/signal" />
        </shape>
    </item>

    <item android:drawable="@android:color/transparent" />

</selector>
