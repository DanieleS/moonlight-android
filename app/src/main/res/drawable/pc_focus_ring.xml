<?xml version="1.0" encoding="utf-8"?>
<!--
    @drawable/tile_focus_ring for the PC grid, whose cells hold an icon over a label rather
    than art, and so are ringed as a whole cell. The breathing room is the cell's own
    padding.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="120">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/pc_tile_corner" />
            <solid android:color="@color/signal_wash" />
            <stroke
                android:width="@dimen/tile_focus_stroke"
                android:color="@color/signal" />
        </shape>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/pc_tile_corner" />
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="@dimen/tile_focus_stroke"
                android:color="@color/signal" />
        </shape>
    </item>

    <item android:drawable="@android:color/transparent" />

</selector>
