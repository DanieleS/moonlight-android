<?xml version="1.0" encoding="utf-8"?>
<!--
    The ground a PC card sits on: a raised surface with a hairline around it, the same
    grammar the companion surface uses. The focus ring is drawn over this, as the cell's
    foreground, so a focused card is ringed rather than lifted.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="@dimen/pc_card_corner" />
    <solid android:color="@color/surface_raised" />
    <stroke
        android:width="1dp"
        android:color="@color/divider" />

</shape>
