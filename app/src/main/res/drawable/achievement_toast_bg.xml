<?xml version="1.0" encoding="utf-8"?>
<!-- The unlock toast: the menu sheet's raised surface, slightly translucent so it sits over a
     game without blacking out the corner it covers. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/menu_sheet_corner" />
    <solid android:color="#F0212121" />
    <stroke
        android:width="1dp"
        android:color="@color/divider" />
</shape>
