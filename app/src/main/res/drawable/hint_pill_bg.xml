<?xml version="1.0" encoding="utf-8"?>
<!--
    The ground for an on-screen hint: a dark capsule that stays legible over any cover art.
    Pressed, it fills with the signal wash, the same way a tile does.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="120">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/signal_wash" />
            <stroke
                android:width="1dp"
                android:color="@color/signal" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#99000000" />
            <stroke
                android:width="1dp"
                android:color="@color/divider" />
        </shape>
    </item>

</selector>
