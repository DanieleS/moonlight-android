<?xml version="1.0" encoding="utf-8"?>
<!--
    The palette. Every colour the app draws comes from here.

    The scale is the one the companion surface arrived at: a cold near-black ground,
    content in four steps of prominence, hairlines rather than drop shadows, and exactly
    one saturated hue, spent only on what is live or what is focused.
-->
<resources>

    <!-- Grounds, darkest first. surface_deep is true black: on the OLED panels it is the
         void, pixels physically off, so a lifted near-black does not glow beside the game
         or the bezel. -->
    <color name="surface_deep">#FF000000</color>
    <color name="surface">#FF1A1A1A</color>
    <color name="surface_raised">#FF212121</color>

    <!-- Laid over the stream, where the game is the ground. -->
    <color name="scrim">#80000000</color>

    <!-- Laid over box art, to say the app behind it is already running. -->
    <color name="scrim_soft">#66000000</color>

    <!-- Content, most prominent first. -->
    <color name="content_primary">#FFF2F5F8</color>
    <color name="content_secondary">#FFBFC7D2</color>
    <color name="content_muted">#FF8A94A6</color>
    <color name="content_faint">#FF6E7A8A</color>

    <!-- Hairline rules. -->
    <color name="divider">#22FFFFFF</color>

    <!-- The signal. -->
    <color name="signal">#FF4FC3F7</color>

    <!-- The signal, thinned to a wash, for the moment a focused tile is pressed. -->
    <color name="signal_wash">#334FC3F7</color>

    <!--
        The signal, sunk into the ground: a deep, desaturated teal-blue for a filled
        container that must still read as "the accent" without emitting the light a full
        signal fill would. Used for Material's primaryContainer (selected chips, tonal
        buttons) so those components stay on-brand and OLED-quiet.
    -->
    <color name="signal_container">#FF10333F</color>

    <!--
        Read on the signal. The accent is a light blue, so what sits on top of it is the
        ground, not white.
    -->
    <color name="on_signal">#FF00131A</color>

    <!--
        The one warning hue. Kept for Material's error role (destructive dialogs, invalid
        input). A muted rose rather than a fire-engine red, to sit inside the same cold,
        low-glow scale as everything else.
    -->
    <color name="danger">#FFF2B8B5</color>
    <color name="danger_container">#FF3A1512</color>
    <color name="on_danger">#FF370B08</color>

    <!--
        Surface containers, the Material 3 tonal ladder, expressed in this app's terms:
        near-black grounds that step up by a hair rather than by a lift. They exist so
        Material components (dialogs, sheets, menus) that ask for a container surface get
        one that belongs to the OLED scale instead of Material's lifted greys.
    -->
    <color name="surface_container_lowest">#FF000000</color>
    <color name="surface_container_low">#FF161616</color>
    <color name="surface_container">#FF1E1E1E</color>
    <color name="surface_container_high">#FF262626</color>
    <color name="surface_container_highest">#FF2E2E2E</color>

    <!--
        A solid outline, for the strokes Material draws (outlined buttons, text fields,
        switch tracks). @color/divider is a translucent hairline meant to lie over a known
        ground; an outline has to hold on its own, so it is opaque.
    -->
    <color name="outline">#FF4A5361</color>
    <color name="outline_variant">#FF2A2E34</color>

</resources>
